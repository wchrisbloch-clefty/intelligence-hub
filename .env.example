# Intelligence Hub — environment variables
# Copy this file to .env.local for local dev and fill in real values there.
# .env.local is gitignored and must NEVER be committed.

# ── AI summary providers (used by /api/summarize.js) ──
GROQ_API_KEY=
GOOGLE_AI_KEY=
ANTHROPIC_API_KEY=

# ── Supabase (cross-device persistence + auth) ──
# Project → Settings → API. The anon key is safe to expose to the browser;
# RLS on the app_state table scopes every row to the signed-in user.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── YouTube Data API v3 (used by /api/youtube.js) ──
# Get a key at https://console.cloud.google.com → enable "YouTube Data API v3".
# Restrict the key to the YouTube Data API v3 only. Read server-side only.
YOUTUBE_API_KEY=
