# Intelligence Hub — server environment variables (set these in Vercel →
# Project → Settings → Environment Variables). None of these are exposed to
# the browser; they are read only inside /api/* serverless functions.

# Anthropic API key — powers every AI feature via /api/chat.
ANTHROPIC_API_KEY=

# Access code for the lock screen. Any passphrase you choose.
ACCESS_CODE=

# Upstash Redis (added automatically by the Vercel Upstash Marketplace
# integration). Either the Upstash-native or Vercel-KV names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional extra summary providers used by /api/summarize (podcast/news):
# GROQ_API_KEY=
# GOOGLE_AI_KEY=
